<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ================================================================== -->
    <!-- PERMISOS REQUERIDOS POR LA APLICACIÓN -->
    <!-- ================================================================== -->
    
    <!-- Permiso básico de internet para el streaming y las peticiones HTTP. -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Verificar estado de la red para detectar desconexiones y gestionar reconexiones. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Verificar estado del WiFi (puede ser útil para decisiones de streaming). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    
    <!-- Mantener la CPU activa durante reproducción (evita que el sistema duerma la aplicación
         y corte el audio). Es el permiso nativo para el Wake Lock de MainActivity.kt. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Reproducción en background (cuando la app está minimizada), requerido por just_audio/radio_player. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    
    <!-- Tipo específico de servicio en foreground para Android 14 (API 34) y superiores. 
         Es obligatorio declarar el tipo si se usa FOREGROUND_SERVICE. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Permisos para controlar el volumen del sistema, utilizado por el paquete volume_controller. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    
    <!-- Para evitar que el modo Doze (ahorro de batería) detenga la app en segundo plano. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    
    <!-- Para Android 12+ (API 31+): permite usar alarmas exactas, que pueden ser necesarias 
         para programar temporizadores de apagado o reconexión precisa. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <!-- Permiso para acceder al identificador de publicidad (AD ID) en dispositivos con Google Play Services. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>

    <application
        android:label="Jóvenes Cristianos"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true"
    android:resizeableActivity="true">

            <!-- Tema de arranque -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- Actividad principal -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Deep link para tu dominio -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                    android:host="www.jovenescristianos.co"/>
            </intent-filter>
        </activity>

        <!-- Requerido por Flutter -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Visibilidad de intents (requerido desde Android 11) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
